{
  "name": "shelterconnect-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "bootstrap-admin": "tsx --env-file=.env src/bootstrap-admin.ts",
    "check": "tsc --noEmit",
    "seed-demo": "tsx --env-file=.env src/seed-demo.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
