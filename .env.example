# Both processes must resolve this to the *same absolute* SQLite file in a
# deployment. The development defaults resolve to ./data/shelterconnect.sqlite3.
# DATABASE_URL=sqlite:////absolute/path/to/shelterconnect.sqlite3
# DATABASE_FILE=/absolute/path/to/shelterconnect.sqlite3

# Next / Better Auth (server-only values; do not prefix these with NEXT_PUBLIC_)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI JWT validation. These must match the Better Auth JWT plugin settings.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=shelterconnect-api
BACKEND_CORS_ORIGINS=http://localhost:3000

# Twilio is used for phone OTP and opted-in driver ride alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LOCAL DEMO ONLY — never enable these in a deployment.
# SMS_DEV_CONSOLE=true prints SMS (including sign-in codes) to the Next.js
# terminal when Twilio is not configured, so driver sign-up works offline.
# DRIVER_AUTO_VERIFY=true marks new driver profiles verified so they can go
# online and accept rides without a super administrator.
SMS_DEV_CONSOLE=true
DRIVER_AUTO_VERIFY=true

# Set these only when running `pnpm auth:bootstrap-admin`.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=ShelterConnect Administrator
