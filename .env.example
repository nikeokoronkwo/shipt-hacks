# Both processes must resolve this to the *same absolute* SQLite file in a
# deployment. The development defaults resolve to ./data/shelterconnect.sqlite3.
# DATABASE_URL=sqlite:////absolute/path/to/shelterconnect.sqlite3
# DATABASE_FILE=/absolute/path/to/shelterconnect.sqlite3

# Next / Better Auth (server-only values; do not prefix these with NEXT_PUBLIC_)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional: the first account registered with this exact email becomes the demo
# super administrator. Remove this in a production deployment.
# DEMO_SUPER_ADMIN_EMAIL=admin@shelterconnect.demo

# FastAPI JWT validation. These must match the Better Auth JWT plugin settings.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=shelterconnect-api
BACKEND_CORS_ORIGINS=http://localhost:3000
